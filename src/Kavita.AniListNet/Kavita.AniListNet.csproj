<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <Title>AniList.NET</Title>
        <PackageIcon>icon.png</PackageIcon>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Authors>Dennise Catolos,Kavita</Authors>
        <Description>A simple .NET API wrapper for AniList!</Description>
        <PackageProjectUrl>https://github.com/Kareadita/anilistnet/</PackageProjectUrl>
        <Version>0.1.4</Version>
    </PropertyGroup>

    <PropertyGroup>
        <IncludeSymbols>true</IncludeSymbols>
        <PackageId>Kavita.AniListNet</PackageId>
        <AssemblyName>Kavita.AniListNet</AssemblyName>
        <RootNamespace>Kavita.AniListNet</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <MinVerDefaultPreReleaseIdentifiers>preview</MinVerDefaultPreReleaseIdentifiers>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\docs\icon.png" Pack="true" PackagePath="\">
            <Pack>True</Pack>
            <Link>icon.png</Link>
        </None>
    </ItemGroup>
</Project>
